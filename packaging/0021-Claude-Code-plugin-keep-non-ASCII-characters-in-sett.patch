From edb5f4bb632d871342027bd05fa0321290a4f7fa Mon Sep 17 00:00:00 2001
From: jason <9142024+jasondma@users.noreply.github.com>
Date: Mon, 23 Nov 2026 20:23:30 -0500
Subject: [PATCH 21/21] Claude Code plugin: keep non-ASCII characters in
 settings.json
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

konsole-claude-setup wrote characters like — and × as \u2014 escapes,
which reads badly and fills a diff of the settings with unrelated lines.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/plugins/ClaudeCode/setup/konsole-claude-setup.in | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/plugins/ClaudeCode/setup/konsole-claude-setup.in b/src/plugins/ClaudeCode/setup/konsole-claude-setup.in
index cc9f1ba..ce57799 100644
--- a/src/plugins/ClaudeCode/setup/konsole-claude-setup.in
+++ b/src/plugins/ClaudeCode/setup/konsole-claude-setup.in
@@ -77,7 +77,8 @@ def save(path, settings):
     # Write and rename, so Claude Code never reads a half-written file.
     fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".settings.", suffix=".json")
     with os.fdopen(fd, "w", encoding="utf-8") as f:
-        json.dump(settings, f, indent=2)
+        # Keep characters like "—" as they are, not as — escapes.
+        json.dump(settings, f, indent=2, ensure_ascii=False)
         f.write("\n")
     if os.path.exists(path):
         shutil.copymode(path, temporary)
-- 
