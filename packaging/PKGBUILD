# Maintainer: Eric Duprey <509630+destinal@users.noreply.github.com>
# Based on Arch Linux's konsole package (Felix Yan, Antonio Rojas).
#
# Konsole with a Claude Code integration modeled on iTerm2's: status in tabs,
# a sessions panel and notifications, workgroups (Chat, Diff, Code Review)
# and review clippings. The patches are generated from the claude-integration
# branch of https://github.com/destinal/konsole; update-konsole.sh moves them
# to a new Konsole release. cc-status is built from ../cc-status.

pkgname=konsole-claude
_pkgname=konsole
pkgver=26.08.2
pkgrel=1
arch=(x86_64)
url='https://apps.kde.org/konsole/'
pkgdesc='KDE terminal emulator, with a Claude Code integration'
license=(GPL-2.0-or-later
         LGPL-2.0-or-later
         GPL-2.0-only) # cc-status and parts of the plugin, from iTerm2
