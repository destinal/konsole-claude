+# A stand-in for iTerm2's it2 command, covering what cc-status runs. It is
+# named it2 because cc-status looks for it2 next to its own executable.
+add_executable(claudecode-it2 it2.cpp)
+set_target_properties(claudecode-it2 PROPERTIES
+    OUTPUT_NAME it2
+    RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin/claudecode
+)
+target_link_libraries(claudecode-it2 Qt::Core Qt::DBus)
+install(TARGETS claudecode-it2 DESTINATION ${KDE_INSTALL_LIBEXECDIR}/konsole-claudecode)
+
+# The hook Claude Code runs, installed beside it2 and cc-status. cc-status is
+# built separately, with Swift, from iTerm2's source.
+configure_file(${CMAKE_CURRENT_SOURCE_DIR}/../hook/claude-code-hook ${CMAKE_BINARY_DIR}/bin/claudecode/claude-code-hook COPYONLY)
+install(PROGRAMS ${CMAKE_CURRENT_SOURCE_DIR}/../hook/claude-code-hook DESTINATION ${KDE_INSTALL_LIBEXECDIR}/konsole-claudecode)
diff --git a/src/plugins/ClaudeCode/it2/it2.cpp b/src/plugins/ClaudeCode/it2/it2.cpp
new file mode 100644
index 0000000..154d4a0
--- /dev/null
+++ b/src/plugins/ClaudeCode/it2/it2.cpp
@@ -0,0 +1,255 @@
+// SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// A stand-in for iTerm2's it2 command, covering the calls cc-status makes:
+//
+//   it2 set-status --session=<id> [--quiet-if-unresolved] [--json] [--status=...] ...
+//   it2 session get-status --session=<id> [--quiet-if-unresolved]
+//   it2 session get-background-tasks --session=<id> [--quiet-if-unresolved]
+//
+// Each becomes a call to the Claude Code plugin's D-Bus object in Konsole.
+// The session id is what cc-status takes from $TERM_SESSION_ID, which the
+// Konsole hook wrapper sets to "konsole:<D-Bus service><session path>", for
+// example "konsole:org.kde.konsole-1234/Sessions/3".
+//
+// Options take "--name=value" or "--name value". An empty value always comes
+// as two arguments. Exit status: 0 on success, 1 when the call failed, 2 for
+// a usage error.
+
+#include <QCoreApplication>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusVariant>
+#include <QStringList>
+#include <QTextStream>
+#include <QVariantMap>
+
+#include <cstdio>
+
+namespace
+{
+enum class Kind {
+    Text,
+    Integer,
+    Boolean,
+};
+
+// The set-status options and how each is sent to the plugin. The D-Bus
+// argument names are iTerm2's set_session_status ones.
+struct StatusOption {
+    const char *name;
+    const char *argument;
+    Kind kind;
+};
+
+const StatusOption statusOptions[] = {
+    {"status", "status", Kind::Text},
+    {"dot-color", "dot_color", Kind::Text},
+    {"text-color", "text_color", Kind::Text},
+    {"detail", "detail", Kind::Text},
+    {"background-tasks", "background_tasks", Kind::Integer},
+    {"background-tasks-delta", "background_tasks_delta", Kind::Integer},
+    {"turn-open", "turn_open", Kind::Boolean},
+    {"if-turn-open", "if_turn_open", Kind::Boolean},
+    {"if-background-tasks", "if_background_tasks", Kind::Integer},
+    {"expires-on", "expires_on", Kind::Text},
+    {"then-status", "then_status", Kind::Text},
+    {"then-dot-color", "then_dot_color", Kind::Text},
+    {"then-text-color", "then_text_color", Kind::Text},
+    {"then-detail", "then_detail", Kind::Text},
+};
+
+const QStringList addressOptions = {QStringLiteral("session"), QStringLiteral("tmux"), QStringLiteral("tmux-pane")};
+const QStringList flagOptions = {QStringLiteral("json"), QStringLiteral("quiet-if-unresolved")};
+
+struct Invocation {
+    QString command;
+    QHash<QString, QString> options;
+    QSet<QString> flags;
+};
+
+QTextStream &err()
+{
+    static QTextStream stream(stderr);
+    return stream;
+}
+
+QTextStream &out()
+{
+    static QTextStream stream(stdout);
+    return stream;
+}
+
+bool isValueOption(const QString &name)
+{
+    if (addressOptions.contains(name)) {
+        return true;
+    }
+    for (const auto &option : statusOptions) {
+        if (name == QLatin1String(option.name)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Parses the command line, or returns false after printing a usage error.
+bool parse(const QStringList &arguments, Invocation *invocation)
+{
+    int i = 0;
+    if (arguments.value(0) == QLatin1String("set-status")) {
+        invocation->command = QStringLiteral("set-status");
+        i = 1;
+    } else if (arguments.value(0) == QLatin1String("session")
+               && (arguments.value(1) == QLatin1String("get-status") || arguments.value(1) == QLatin1String("get-background-tasks"))) {
+        invocation->command = arguments.value(1);
+        i = 2;
+    } else {
+        err() << "it2: unsupported command: " << arguments.join(QLatin1Char(' ')) << Qt::endl;
+        return false;
+    }
+
+    for (; i < arguments.size(); i++) {
+        const QString &argument = arguments.at(i);
+        if (!argument.startsWith(QLatin1String("--"))) {
+            err() << "it2: unexpected argument: " << argument << Qt::endl;
+            return false;
+        }
+        const qsizetype separator = argument.indexOf(QLatin1Char('='));
+        const QString name = argument.mid(2, separator < 0 ? -1 : separator - 2);
+        if (flagOptions.contains(name) && separator < 0) {
+            invocation->flags.insert(name);
+        } else if (!isValueOption(name)) {
+            err() << "it2: unknown option: --" << name << Qt::endl;
+            return false;
+        } else if (separator >= 0) {
+            invocation->options.insert(name, argument.mid(separator + 1));
+        } else if (i + 1 < arguments.size()) {
+            invocation->options.insert(name, arguments.at(++i));
+        } else {
+            err() << "it2: missing value for --" << name << Qt::endl;
+            return false;
+        }
+    }
+    return true;
+}
+
+// Splits a session id into the Konsole D-Bus service and session path.
+bool resolve(const Invocation &invocation, QString *service, QString *session)
+{
+    // A tmux pane is not something Konsole can map to a session yet.
+    if (invocation.options.contains(QStringLiteral("tmux"))) {
+        return false;
+    }
+    const QString id = invocation.options.value(QStringLiteral("session"));
+    const qsizetype path = id.indexOf(QLatin1String("/Sessions/"));
+    if (path <= 0) {
+        return false;
+    }
+    *service = id.left(path);
+    *session = id.mid(path);
+    return true;
+}
+
+// Builds the set-status arguments for the plugin, or returns false after
+// printing what is wrong.
+bool statusArguments(const Invocation &invocation, QVariantMap *arguments)
+{
+    for (const auto &option : statusOptions) {
+        const auto it = invocation.options.constFind(QLatin1String(option.name));
+        if (it == invocation.options.cend()) {
+            continue;
+        }
+        bool ok = true;
+        QVariant value;
+        switch (option.kind) {
+        case Kind::Text:
+            value = *it;
+            break;
+        case Kind::Integer:
+            value = it->toLongLong(&ok);
+            break;
+        case Kind::Boolean:
+            ok = *it == QLatin1String("true") || *it == QLatin1String("false");
+            value = *it == QLatin1String("true");
+            break;
+        }
+        if (!ok) {
+            err() << "it2: invalid value for --" << option.name << ": " << *it << Qt::endl;
+            return false;
+        }
+        arguments->insert(QLatin1String(option.argument), value);
+    }
+    return true;
+}
+
+// Whether a failed call means the session could not be found, as opposed to
+// the call itself being wrong. Konsole not running, the plugin not loaded and
+// an unknown session all count.
+bool isUnresolved(const QDBusMessage &reply)
+{
+    const QString name = reply.errorName();
+    return name == QLatin1String("org.freedesktop.DBus.Error.ServiceUnknown") || name == QLatin1String("org.freedesktop.DBus.Error.NameHasNoOwner")
+        || name == QLatin1String("org.freedesktop.DBus.Error.UnknownObject") || name == QLatin1String("org.freedesktop.DBus.Error.UnknownMethod")
+        || name == QLatin1String("org.freedesktop.DBus.Error.UnknownInterface") || name == QLatin1String("org.kde.konsole.ClaudeCode.NoSuchSession");
+}
+}
+
+int main(int argc, char *argv[])
+{
+    QCoreApplication app(argc, argv);
+    QStringList arguments = app.arguments();
+    arguments.removeFirst();
+
+    Invocation invocation;
+    if (!parse(arguments, &invocation)) {
+        return 2;
+    }
+    const bool quiet = invocation.flags.contains(QStringLiteral("quiet-if-unresolved"));
+
+    QString service;
+    QString session;
+    if (!resolve(invocation, &service, &session)) {
+        if (quiet) {
+            return 0;
+        }
+        err() << "it2: cannot find a Konsole session for this pane" << Qt::endl;
+        return 1;
+    }
+
+    QDBusMessage call;
+    const QString path = QStringLiteral("/ClaudeCode");
+    const QString interface = QStringLiteral("org.kde.konsole.ClaudeCode");
+    if (invocation.command == QLatin1String("set-status")) {
+        QVariantMap statusArgs;
+        if (!statusArguments(invocation, &statusArgs)) {
+            return 2;
+        }
+        call = QDBusMessage::createMethodCall(service, path, interface, QStringLiteral("setStatus"));
+        call << session << statusArgs;
+    } else if (invocation.command == QLatin1String("get-status")) {
+        call = QDBusMessage::createMethodCall(service, path, interface, QStringLiteral("getStatus"));
+        call << session;
+    } else {
+        call = QDBusMessage::createMethodCall(service, path, interface, QStringLiteral("getBackgroundTaskCount"));
+        call << session;
+    }
+
+    // A status update is cosmetic: never hold up the hook for long.
+    const QDBusMessage reply = QDBusConnection::sessionBus().call(call, QDBus::Block, 5000);
+    if (reply.type() == QDBusMessage::ErrorMessage) {
+        if (quiet && isUnresolved(reply)) {
+            return 0;
+        }
+        err() << "it2: " << reply.errorMessage() << Qt::endl;
+        return 1;
+    }
+
+    const QVariant result = reply.arguments().value(0);
+    if (invocation.command == QLatin1String("set-status") && !invocation.flags.contains(QStringLiteral("json"))) {
+        out() << "Session status updated." << Qt::endl;
+    } else {
+        out() << result.toString() << Qt::endl;
+    }
+    return 0;
+}
diff --git a/src/plugins/ClaudeCode/sessionstatus.cpp b/src/plugins/ClaudeCode/sessionstatus.cpp
new file mode 100644
index 0000000..b534c6d
--- /dev/null
+++ b/src/plugins/ClaudeCode/sessionstatus.cpp
@@ -0,0 +1,432 @@
+// SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "sessionstatus.h"
+
+#include <QTimer>
+
+#include <algorithm>
+#include <limits>
+
+using Konsole::TabStatusFields;
+using Konsole::TerminalProgress;
+
+namespace
+{
+// cc-status's idle colors, used when a key press turns a finished turn idle.
+const QColor idleIndicator(0x00, 0xd7, 0x5f);
+const QColor idleStatusColor(0x88, 0x88, 0x88);
+
+std::optional<QString> stringArgument(const QVariantMap &arguments, const char *key)
+{
+    const auto it = arguments.constFind(QLatin1String(key));
+    if (it == arguments.cend()) {
+        return std::nullopt;
+    }
+    return it->toString();
+}
+
+std::optional<qint64> integerArgument(const QVariantMap &arguments, const char *key, bool *valid)
+{
+    const auto it = arguments.constFind(QLatin1String(key));
+    if (it == arguments.cend()) {
+        return std::nullopt;
+    }
+    bool ok = false;
+    const qint64 value = it->toLongLong(&ok);
+    if (!ok) {
+        *valid = false;
+    }
+    return value;
+}
+
+std::optional<bool> boolArgument(const QVariantMap &arguments, const char *key, bool *valid)
+{
+    const auto it = arguments.constFind(QLatin1String(key));
+    if (it == arguments.cend()) {
+        return std::nullopt;
+    }
+    if (it->typeId() == QMetaType::Bool) {
+        return it->toBool();
+    }
+    const QString text = it->toString();
+    if (text == QLatin1String("true") || text == QLatin1String("1")) {
+        return true;
+    }
+    if (text == QLatin1String("false") || text == QLatin1String("0")) {
+        return false;
+    }
+    *valid = false;
+    return std::nullopt;
+}
+
+// A color argument: #rrggbb or #rgb. An empty one clears the field, which an
+// invalid QColor stands for.
+std::optional<QColor> parseColor(const QString &text)
+{
+    if (text.isEmpty()) {
+        return QColor();
+    }
+    if (!text.startsWith(QLatin1Char('#')) || (text.size() != 4 && text.size() != 7)) {
+        return std::nullopt;
+    }
+    const QColor color = QColor::fromString(text);
+    return color.isValid() ? std::optional<QColor>(color) : std::nullopt;
+}
+
+// Fills one set of visible fields. The status and the fallback it expires to
+// take the same fields, parsed the same way. Returns false and sets the error
+// when a color does not parse.
+bool populate(TabStatusFields &fields, const QVariantMap &arguments, const QString &prefix, QString *error)
+{
+    const auto key = [&prefix](const char *name) {
+        return (prefix + QLatin1String(name)).toLatin1();
+    };
+    fields.status = stringArgument(arguments, key("status").constData());
+    fields.detail = stringArgument(arguments, key("detail").constData());
+
+    for (const char *name : {"text_color", "dot_color"}) {
+        const auto text = stringArgument(arguments, key(name).constData());
+        if (!text.has_value()) {
+            continue;
+        }
+        const auto color = parseColor(*text);
+        if (!color.has_value()) {
+            *error = QStringLiteral("Invalid %1%2 (expected #rrggbb)").arg(prefix, QLatin1String(name));
+            return false;
+        }
+        (qstrcmp(name, "text_color") == 0 ? fields.statusColor : fields.indicator) = color;
+    }
+    return true;
+}
+}
+
+bool StatusUpdate::assertsStatus() const
+{
+    return fields != TabStatusFields() || expiresOnProgressEnd;
+}
+
+StatusUpdate StatusUpdate::fromTabStatus(const Konsole::TabStatusUpdate &update)
+{
+    StatusUpdate result;
+    result.fields = update.fields;
+    result.expiresOnProgressEnd = update.expiresOnProgressEnd;
+    result.fallback = update.fallback;
+    return result;
+}
+
+std::optional<StatusUpdate> StatusUpdate::fromArguments(const QVariantMap &arguments, QString *error)
+{
+    StatusUpdate update;
+    if (!populate(update.fields, arguments, QString(), error)) {
+        return std::nullopt;
+    }
+
+    bool valid = true;
+    const auto backgroundTasks = integerArgument(arguments, "background_tasks", &valid);
+    const auto delta = integerArgument(arguments, "background_tasks_delta", &valid);
+    update.turnOpen = boolArgument(arguments, "turn_open", &valid);
+    update.requiredTurnOpen = boolArgument(arguments, "if_turn_open", &valid);
+    update.requiredBackgroundTasks = integerArgument(arguments, "if_background_tasks", &valid);
+    if (!valid) {
+        *error = QStringLiteral("Invalid number or boolean argument");
+        return std::nullopt;
+    }
+    if (backgroundTasks.has_value() && delta.has_value()) {
+        *error = QStringLiteral("Pass background_tasks or background_tasks_delta, not both.");
+        return std::nullopt;
+    }
+    if (backgroundTasks.has_value()) {
+        update.backgroundTasks = std::max<qint64>(0, *backgroundTasks);
+    }
+    update.backgroundTasksDelta = delta;
+
+    const QString then = QStringLiteral("then_");
+    const bool hasFallbackArguments = std::any_of(arguments.keyBegin(), arguments.keyEnd(), [&then](const QString &key) {
+        return key.startsWith(then);
+    });
+    const QString expiresOn = stringArgument(arguments, "expires_on").value_or(QString());
+    if (!expiresOn.isEmpty()) {
+        if (expiresOn != QLatin1String("progress-end")) {
+            *error = QStringLiteral("Unknown expires_on \"%1\". The only supported value is progress-end.").arg(expiresOn);
+            return std::nullopt;
+        }
+        // With no then_ arguments the status simply goes away when it expires.
+        if (hasFallbackArguments) {
+            if (!populate(update.fallback, arguments, then, error)) {
+                return std::nullopt;
+            }
+        } else {
+            update.fallback = TabStatusFields::cleared();
+        }
+        update.expiresOnProgressEnd = true;
+    } else if (hasFallbackArguments) {
+        *error = QStringLiteral("The then_ arguments only mean something with expires_on, which was not given.");
+        return std::nullopt;
+    }
+    return update;
+}
+
+SessionStatus::SessionStatus(QObject *parent, int progressEndDelayMs)
+    : QObject(parent)
+    , _progressEndDelayMs(progressEndDelayMs)
+{
+}
+
+std::optional<QString> SessionStatus::statusText() const
+{
+    return _display.statusText;
+}
+
+QColor SessionStatus::indicator() const
+{
+    return _display.indicator;
+}
+
+QColor SessionStatus::statusColor() const
+{
+    return _display.statusColor;
+}
+
+std::optional<QString> SessionStatus::detail() const
+{
+    return _display.detail;
+}
+
+qint64 SessionStatus::backgroundTasks() const
+{
+    return _backgroundTasks;
+}
+
+std::optional<bool> SessionStatus::turnOpen() const
+{
+    return _turnOpen;
+}
+
+bool SessionStatus::hasActiveStatus() const
+{
+    return _display.indicator.isValid() || _display.statusText.has_value();
+}
+
+bool SessionStatus::hasArmedExpiration() const
+{
+    return _armedFallback.has_value();
+}
+
+bool SessionStatus::preconditionsHold(const StatusUpdate &update) const
+{
+    // An unknown turn flag satisfies neither value.
+    if (update.requiredTurnOpen.has_value() && _turnOpen != update.requiredTurnOpen) {
+        return false;
+    }
+    if (update.requiredBackgroundTasks.has_value() && _backgroundTasks != *update.requiredBackgroundTasks) {
+        return false;
+    }
+    return true;
+}
+
+bool SessionStatus::apply(const StatusUpdate &update)
+{
+    // A dropped update must not supersede an armed expiration either: the
+    // status it would have replaced is still the one last asserted.
+    if (!preconditionsHold(update)) {
+        return false;
+    }
+
+    const bool asserts = update.assertsStatus();
+    if (asserts) {
+        // Whether the expiration being replaced was already released by the
+        // timer and only held back by background work. Read before the update
+        // lands, since it may carry a new count.
+        const bool previousWasHeld = _armedFallback.has_value() && _headStartElapsed && _generation == _operationEndGeneration && _backgroundTasks > 0;
+
+        // A new assertion supersedes whatever the last one asked to happen
+        // when it went stale; bumping the generation drops its timer.
+        _armedFallback = update.expiresOnProgressEnd ? std::optional<TabStatusFields>(update.fallback) : std::nullopt;
+        ++_generation;
+
+        // Re-armed while the last expiration was held: no operation has
+        // started since the one that ended, so this expiration belongs to it,
+        // and the count must stay able to release it.
+        if (previousWasHeld && _armedFallback.has_value()) {
+            _operationEndGeneration = _generation;
+        }
+    }
+
+    const auto previousText = _display.statusText;
+    if (applyToState(update)) {
+        Q_EMIT changed(previousText);
+    }
+
+    // A count arriving after the head start may report that the last of the
+    // background work holding an expiration has finished. Only a count can
+    // change that answer, and an assertion since the operation ended belongs
+    // to an operation that has not ended yet.
+    const bool changesCount = update.backgroundTasks.has_value() || update.backgroundTasksDelta.has_value();
+    if (!asserts && changesCount && _headStartElapsed && _generation == _operationEndGeneration) {
+        expireNow();
+    }
+    return true;
+}
+
+bool SessionStatus::applyToState(const StatusUpdate &update)
+{
+    const bool changed = applyFields(update.fields);
+
+    if (update.backgroundTasks.has_value()) {
+        _backgroundTasks = *update.backgroundTasks;
+    } else if (update.backgroundTasksDelta.has_value()) {
+        // The delta comes from a command line, so saturate instead of overflowing.
+        const qint64 delta = *update.backgroundTasksDelta;
+        qint64 sum = 0;
+        if (__builtin_add_overflow(_backgroundTasks, delta, &sum)) {
+            _backgroundTasks = delta > 0 ? std::numeric_limits<qint64>::max() : 0;
+        } else {
+            _backgroundTasks = std::max<qint64>(0, sum);
+        }
+    }
+    if (update.turnOpen.has_value()) {
+        _turnOpen = update.turnOpen;
+    }
+    // The count and the turn flag never count as a visible change.
+    return changed;
+}
+
+bool SessionStatus::applyFields(const TabStatusFields &fields)
+{
+    const Display before = _display;
+    if (fields.indicator.has_value()) {
+        _display.indicator = *fields.indicator;
+    }
+    if (fields.status.has_value()) {
+        _display.statusText = fields.status->isEmpty() ? std::nullopt : fields.status;
+    }
+    if (fields.statusColor.has_value()) {
+        _display.statusColor = *fields.statusColor;
+    }
+    if (fields.detail.has_value()) {
+        _display.detail = fields.detail->isEmpty() ? std::nullopt : fields.detail;
+    }
+    return !(_display == before);
+}
+
+void SessionStatus::progressReported(const std::optional<TerminalProgress> &progress)
+{
+    // A stop ends the operation, and so does an error: a program that reports
+    // a failure may exit without ever reporting a stop. Paused and percentages
+    // mean it is still running.
+    const bool endsOperation = !progress.has_value() || progress->state == TerminalProgress::Error;
+    if (!endsOperation) {
+        _progressWasRunning = true;
+        _headStartElapsed = false;
+        // Whatever ended a moment ago evidently did not stay ended.
+        ++_generation;
+        return;
+    }
+    if (!_progressWasRunning) {
+        return;
+    }
+    _progressWasRunning = false;
+    ++_generation;
+    _operationEndGeneration = _generation;
+    if (!_armedFallback.has_value()) {
+        return;
+    }
+    const int scheduled = _generation;
+    QTimer::singleShot(_progressEndDelayMs, this, [this, scheduled] {
+        expire(scheduled);
+    });
+}
+
+void SessionStatus::expire(int scheduledGeneration)
+{
+    if (scheduledGeneration != _generation) {
+        return;
+    }
+    // From here a held expiration is released the moment its count changes.
+    _headStartElapsed = true;
+    expireNow();
+}
+
+void SessionStatus::expireNow()
+{
+    // Stays armed while background work is counted: the program has not
+    // finished, and the status it last asserted is still the true one.
+    if (!_armedFallback.has_value() || _backgroundTasks != 0) {
+        return;
+    }
+    const TabStatusFields fallback = *_armedFallback;
+    _armedFallback.reset();
+    const auto previousText = _display.statusText;
+    if (applyFields(fallback)) {
+        Q_EMIT changed(previousText);
+    }
+}
+
+void SessionStatus::userDidPressKey()
+{
+    const QString text = _display.statusText.value_or(QString()).toLower();
+    if (text != QLatin1String("done") && text != QLatin1String("error")) {
+        return;
+    }
+    StatusUpdate idle;
+    idle.fields.status = QStringLiteral("idle");
+    idle.fields.indicator = idleIndicator;
+    idle.fields.statusColor = idleStatusColor;
+    apply(idle);
+}
+
+bool SessionStatus::clearStatus()
+{
+    // An expiration can be armed without a visible field, and must not
+    // outlive the clear.
+    if (!hasActiveStatus() && !_armedFallback.has_value()) {
+        return false;
+    }
+    _armedFallback.reset();
+    ++_generation;
+    const auto previousText = _display.statusText;
+    _display = Display();
+    _backgroundTasks = 0;
+    _turnOpen.reset();
+    Q_EMIT changed(previousText);
+    return true;
+}
+
+void SessionStatus::programDidExit()
+{
+    const bool wasActive = hasActiveStatus();
+    const auto previousText = _display.statusText;
+    _display = Display();
+    _backgroundTasks = 0;
+    _turnOpen.reset();
+    _armedFallback.reset();
+    ++_generation;
+    // A restarted program starts from having reported nothing.
+    _progressWasRunning = false;
+    _headStartElapsed = false;
+    _operationEndGeneration = 0;
+    if (wasActive) {
+        Q_EMIT changed(previousText);
+    }
+}
+
+QJsonObject SessionStatus::toJson() const
+{
+    const auto text = [](const std::optional<QString> &value) {
+        return value.has_value() ? QJsonValue(*value) : QJsonValue(QJsonValue::Null);
+    };
+    const auto color = [](const QColor &value) {
+        return value.isValid() ? QJsonValue(value.name()) : QJsonValue(QJsonValue::Null);
+    };
+    return {
+        {QStringLiteral("status"), text(_display.statusText)},
+        {QStringLiteral("text_color"), color(_display.statusColor)},
+        {QStringLiteral("dot_color"), color(_display.indicator)},
+        {QStringLiteral("detail"), text(_display.detail)},
+        {QStringLiteral("background_tasks"), _backgroundTasks},
+        {QStringLiteral("turn_open"), _turnOpen.has_value() ? QJsonValue(*_turnOpen) : QJsonValue(QJsonValue::Null)},
+    };
+}
+
+#include "moc_sessionstatus.cpp"
diff --git a/src/plugins/ClaudeCode/sessionstatus.h b/src/plugins/ClaudeCode/sessionstatus.h
new file mode 100644
index 0000000..619aed8
--- /dev/null
+++ b/src/plugins/ClaudeCode/sessionstatus.h
@@ -0,0 +1,163 @@
+// SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#ifndef SESSIONSTATUS_H
+#define SESSIONSTATUS_H
+
+#include "TabStatus.h"
+#include "TerminalProgress.h"
+
+#include <QColor>
+#include <QJsonObject>
+#include <QObject>
+#include <QString>
+#include <QVariantMap>
+
+#include <optional>
+
+/**
+ * One change to a session's status, from `it2 set-status` (through D-Bus)
+ * or from OSC 21337.
+ *
+ * The visible fields follow TabStatusFields: std::nullopt leaves a field
+ * alone, an empty value clears it. The rest is bookkeeping that cc-status
+ * parks here between hook events, preconditions that drop the whole update
+ * when they do not hold, and what to show when the operation the status
+ * belongs to ends.
+ */
+struct StatusUpdate {
+    Konsole::TabStatusFields fields;
+
+    std::optional<qint64> backgroundTasks;
+    std::optional<qint64> backgroundTasksDelta;
+    std::optional<bool> turnOpen;
+
+    std::optional<bool> requiredTurnOpen;
+    std::optional<qint64> requiredBackgroundTasks;
+
+    bool expiresOnProgressEnd = false;
+    Konsole::TabStatusFields fallback;
+
+    /**
+     * Whether the update says anything about what the session is doing, as
+     * opposed to only parking bookkeeping such as the task count. Only such
+     * an assertion replaces an armed expiration.
+     */
+    bool assertsStatus() const;
+
+    static StatusUpdate fromTabStatus(const Konsole::TabStatusUpdate &update);
+
+    /**
+     * Builds an update from `it2 set-status` arguments, keyed as iTerm2's
+     * set_session_status takes them: status, text_color, dot_color, detail,
+     * background_tasks, background_tasks_delta, turn_open, if_turn_open,
+     * if_background_tasks, expires_on and then_status, then_text_color,
+     * then_dot_color, then_detail. Returns std::nullopt and sets @p error for
+     * arguments that make no sense.
+     */
+    static std::optional<StatusUpdate> fromArguments(const QVariantMap &arguments, QString *error);
+};
+
+/**
+ * A session's status as cc-status reports it, and when a status scoped to an
+ * operation stops being true. A port of iTerm2's iTermSessionTabStatus and
+ * TabStatusController.
+ *
+ * A status can say it holds only until the program's current operation
+ * (announced with OSC 9;4 progress) ends, because an interrupt may run no hook
+ * that could report the change. When the operation ends the status gives way
+ * to its fallback, after a head start that lets the program's own, slower
+ * report win, and never while the program still counts background work.
+ */
+class SessionStatus : public QObject
+{
+    Q_OBJECT
+
+public:
+    /** How long an ended operation's status waits before expiring. */
+    static constexpr int defaultProgressEndDelayMs = 3000;
+
+    explicit SessionStatus(QObject *parent = nullptr, int progressEndDelayMs = defaultProgressEndDelayMs);
+
+    std::optional<QString> statusText() const;
+    /** Invalid when there is no indicator. */
+    QColor indicator() const;
+    /** Invalid when there is no status text color. */
+    QColor statusColor() const;
+    std::optional<QString> detail() const;
+    qint64 backgroundTasks() const;
+    std::optional<bool> turnOpen() const;
+
+    /** Whether there is a status to show: an indicator or status text. */
+    bool hasActiveStatus() const;
+    bool hasArmedExpiration() const;
+
+    /**
+     * Applies an update. Returns false when its preconditions did not hold,
+     * in which case nothing changed.
+     */
+    bool apply(const StatusUpdate &update);
+
+    /** The program reported progress with OSC 9;4. */
+    void progressReported(const std::optional<Konsole::TerminalProgress> &progress);
+
+    /** The user pressed a key: a "done" or "error" status has been seen and becomes idle. */
+    void userDidPressKey();
+
+    /** Clears everything. Returns whether there was anything to clear. */
+    bool clearStatus();
+
+    /** The session's program exited: forget the status and the operation. */
+    void programDidExit();
+
+    /**
+     * The status as `it2 set-status --json` and `it2 session get-status`
+     * print it: status, text_color, dot_color, detail (null when unset),
+     * background_tasks and turn_open (null when never reported).
+     */
+    QJsonObject toJson() const;
+
+Q_SIGNALS:
+    /** Something visible changed. */
+    void changed(const std::optional<QString> &previousStatusText);
+
+private:
+    struct Display {
+        QColor indicator;
+        std::optional<QString> statusText;
+        QColor statusColor;
+        std::optional<QString> detail;
+
+        bool operator==(const Display &other) const
+        {
+            return indicator == other.indicator && statusText == other.statusText && statusColor == other.statusColor && detail == other.detail;
+        }
+    };
+
+    bool preconditionsHold(const StatusUpdate &update) const;
+    /** Applies the fields and bookkeeping, returning whether anything visible changed. */
+    bool applyToState(const StatusUpdate &update);
+    bool applyFields(const Konsole::TabStatusFields &fields);
+    void expire(int scheduledGeneration);
+    void expireNow();
+
+    const int _progressEndDelayMs;
+
+    Display _display;
+    qint64 _backgroundTasks = 0;
+    std::optional<bool> _turnOpen;
+
+    // What the current status asked to show when its operation ends.
+    std::optional<Konsole::TabStatusFields> _armedFallback;
+    // Bumped whenever a scheduled expiration stops being valid.
+    int _generation = 0;
+    // Whether the last progress report said something was running; a stop
+    // only ends an operation that was seen to start.
+    bool _progressWasRunning = false;
+    // Whether the head start after the last operation ended has elapsed, and
+    // the generation as of that end.
+    bool _headStartElapsed = false;
+    int _operationEndGeneration = 0;
+};
+
+#endif // SESSIONSTATUS_H
diff --git a/src/plugins/ClaudeCode/sessionstatusregistry.cpp b/src/plugins/ClaudeCode/sessionstatusregistry.cpp
new file mode 100644
index 0000000..bee1f10
--- /dev/null
+++ b/src/plugins/ClaudeCode/sessionstatusregistry.cpp
@@ -0,0 +1,69 @@
+// SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "sessionstatusregistry.h"
+#include "sessionstatus.h"
+
+#include "Emulation.h"
+#include "session/Session.h"
+#include "session/SessionManager.h"
+
+SessionStatusRegistry::SessionStatusRegistry(QObject *parent)
+    : QObject(parent)
+{
+    auto *manager = Konsole::SessionManager::instance();
+    const auto existing = manager->sessions();
+    for (Konsole::Session *session : existing) {
+        track(session);
+    }
+    connect(manager, &Konsole::SessionManager::sessionCreated, this, &SessionStatusRegistry::track);
+}
+
+SessionStatus *SessionStatusRegistry::status(Konsole::Session *session) const
+{
+    return _statuses.value(session);
+}
+
+Konsole::Session *SessionStatusRegistry::session(const QString &identifier) const
+{
+    const QLatin1String prefix("/Sessions/");
+    bool ok = false;
+    const int id = (identifier.startsWith(prefix) ? identifier.mid(prefix.size()) : identifier).toInt(&ok);
+    if (!ok) {
+        return nullptr;
+    }
+    for (auto it = _statuses.cbegin(); it != _statuses.cend(); ++it) {
+        if (it.key()->sessionId() == id) {
+            return it.key();
+        }
+    }
+    return nullptr;
+}
+
+QList<Konsole::Session *> SessionStatusRegistry::sessions() const
+{
+    return _statuses.keys();
+}
+
+void SessionStatusRegistry::track(Konsole::Session *session)
+{
+    if (_statuses.contains(session)) {
+        return;
+    }
+    auto *status = new SessionStatus(this);
+    _statuses.insert(session, status);
+
+    connect(session->emulation(), &Konsole::Emulation::progressChanged, status, &SessionStatus::progressReported);
+    connect(session, &Konsole::Session::tabStatusReceived, status, [status](const Konsole::TabStatusUpdate &update) {
+        status->apply(StatusUpdate::fromTabStatus(update));
+    });
+    connect(session, &Konsole::Session::finished, status, &SessionStatus::programDidExit);
+    connect(status, &SessionStatus::changed, this, [this, session] {
+        Q_EMIT statusChanged(session);
+    });
+    connect(session, &QObject::destroyed, this, [this, session] {
+        delete _statuses.take(session);
+    });
+}
