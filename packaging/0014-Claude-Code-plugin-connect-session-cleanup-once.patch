From a5f57a887e5dafb3ca7a754adf47c3c5b0ecc141 Mon Sep 17 00:00:00 2001
From: Eric Duprey <509630+destinal@users.noreply.github.com>
Date: Fri, 9 Oct 2026 14:50:28 -0700
Subject: [PATCH 14/20] Claude Code plugin: connect session cleanup once

The notifier and the badges connected a lambda to a session's destroyed
signal with Qt::UniqueConnection on every notification or badge. Qt
cannot make a lambda connection unique: debug builds assert, release
builds pile up duplicate connections. Connect once per session instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/plugins/ClaudeCode/statusbadges.cpp   | 14 +++++++-------
 src/plugins/ClaudeCode/statusbadges.h     |  2 ++
 src/plugins/ClaudeCode/statusnotifier.cpp | 14 ++++++--------
 3 files changed, 15 insertions(+), 15 deletions(-)

diff --git a/src/plugins/ClaudeCode/statusbadges.cpp b/src/plugins/ClaudeCode/statusbadges.cpp
index c5670df..64dc5f5 100644
--- a/src/plugins/ClaudeCode/statusbadges.cpp
+++ b/src/plugins/ClaudeCode/statusbadges.cpp
@@ -67,14 +67,14 @@ void StatusBadges::update(Konsole::Session *session)
 
     if (!shown) {
         _saved.insert(session, badgeOf(session));
-        connect(
-            session,
-            &QObject::destroyed,
-            this,
-            [this, session] {
+        // Once per session: a lambda cannot be a unique connection.
+        if (!_watched.contains(session)) {
+            _watched.insert(session);
+            connect(session, &QObject::destroyed, this, [this, session] {
                 _saved.remove(session);
-            },
-            Qt::UniqueConnection);
+                _watched.remove(session);
+            });
+        }
     }
     Badge badge;
     badge.enabled = true;
diff --git a/src/plugins/ClaudeCode/statusbadges.h b/src/plugins/ClaudeCode/statusbadges.h
index b81e8ab..65cfaa1 100644
--- a/src/plugins/ClaudeCode/statusbadges.h
+++ b/src/plugins/ClaudeCode/statusbadges.h
@@ -7,6 +7,7 @@
 #include <QColor>
 #include <QHash>
 #include <QObject>
+#include <QSet>
 #include <QString>
 
 namespace Konsole
@@ -51,6 +52,7 @@ private:
     bool _enabled;
     // The badge each session had before a status badge replaced it.
     QHash<Konsole::Session *, Badge> _saved;
+    QSet<Konsole::Session *> _watched;
 };
 
 #endif // STATUSBADGES_H
diff --git a/src/plugins/ClaudeCode/statusnotifier.cpp b/src/plugins/ClaudeCode/statusnotifier.cpp
index 75f17c3..29473fa 100644
--- a/src/plugins/ClaudeCode/statusnotifier.cpp
+++ b/src/plugins/ClaudeCode/statusnotifier.cpp
@@ -61,17 +61,15 @@ void StatusNotifier::statusChanged(Konsole::Session *session, const std::optiona
     if (sent != _sent.cend() && sent->event == event && sent->timer.elapsed() < repeatIntervalMs) {
         return;
     }
+    if (!_sent.contains(session)) {
+        // Once per session: a lambda cannot be a unique connection.
+        connect(session, &QObject::destroyed, this, [this, session] {
+            _sent.remove(session);
+        });
+    }
     Sent record{event, QElapsedTimer()};
     record.timer.start();
     _sent.insert(session, record);
-    connect(
-        session,
-        &QObject::destroyed,
-        this,
-        [this, session] {
-            _sent.remove(session);
-        },
-        Qt::UniqueConnection);
 
     auto *notification = new KNotification(event, KNotification::CloseWhenWindowActivated);
     notification->setTitle(i18nc("@title a Claude Code session, named by its tab title", "Claude Code — %1", ClaudeCode::sessionTitle(session)));
