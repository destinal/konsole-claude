+        const int detailLines = std::max<qsizetype>(1, wrappedDetail(detailText(index), option.font, detailWidth(rowWidth)).size());
+        return QSize(rowWidth, 2 * padding + (1 + detailLines) * metrics.lineSpacing());
     }
 
