diff --git a/src/plugins/ClaudeCode/statusbadges.cpp b/src/plugins/ClaudeCode/statusbadges.cpp
new file mode 100644
index 0000000..c5670df
--- /dev/null
+++ b/src/plugins/ClaudeCode/statusbadges.cpp
@@ -0,0 +1,100 @@
+// SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "statusbadges.h"
+#include "sessionstatus.h"
+#include "sessionstatusregistry.h"
+
+#include "session/Session.h"
+
+#include <KConfigGroup>
+#include <KSharedConfig>
+
+namespace
+{
+KConfigGroup settings()
+{
+    return KSharedConfig::openConfig()->group(QStringLiteral("ClaudeCode"));
+}
+}
+
+StatusBadges::StatusBadges(SessionStatusRegistry *registry, QObject *parent)
+    : QObject(parent)
+    , _registry(registry)
+    , _enabled(settings().readEntry("ShowStatusBadges", false))
+{
+    connect(_registry, &SessionStatusRegistry::statusChanged, this, &StatusBadges::update);
+    const auto sessions = _registry->sessions();
+    for (Konsole::Session *session : sessions) {
+        update(session);
+    }
+}
+
+bool StatusBadges::isEnabled() const
+{
+    return _enabled;
+}
+
+void StatusBadges::setEnabled(bool enabled)
+{
+    if (_enabled == enabled) {
+        return;
+    }
+    _enabled = enabled;
+    KConfigGroup group = settings();
+    group.writeEntry("ShowStatusBadges", enabled);
+    group.sync();
+
+    const auto sessions = _registry->sessions();
+    for (Konsole::Session *session : sessions) {
+        update(session);
+    }
+    Q_EMIT enabledChanged(enabled);
+}
+
+void StatusBadges::update(Konsole::Session *session)
+{
+    SessionStatus *status = _registry->status(session);
+    const bool show = _enabled && status != nullptr && status->statusText().has_value();
+    const bool shown = _saved.contains(session);
+
+    if (!show) {
+        if (shown) {
+            setBadge(session, _saved.take(session));
+        }
+        return;
+    }
+
+    if (!shown) {
+        _saved.insert(session, badgeOf(session));
+        connect(
+            session,
+            &QObject::destroyed,
+            this,
+            [this, session] {
+                _saved.remove(session);
+            },
+            Qt::UniqueConnection);
+    }
+    Badge badge;
+    badge.enabled = true;
+    badge.text = *status->statusText();
+    badge.color = status->indicator().isValid() ? status->indicator() : status->statusColor();
+    badge.textOnly = false;
+    setBadge(session, badge);
+}
+
+StatusBadges::Badge StatusBadges::badgeOf(Konsole::Session *session)
+{
+    return {session->badgeEnabled(), session->badgeText(), session->badgeColor(), session->badgeTextOnly()};
+}
+
+void StatusBadges::setBadge(Konsole::Session *session, const Badge &badge)
+{
+    session->setBadgeText(badge.text);
+    session->setBadgeColor(badge.color);
+    session->setBadgeTextOnly(badge.textOnly);
+    session->setBadgeEnabled(badge.enabled);
+}
+
+#include "moc_statusbadges.cpp"
diff --git a/src/plugins/ClaudeCode/statusbadges.h b/src/plugins/ClaudeCode/statusbadges.h
new file mode 100644
index 0000000..b81e8ab
--- /dev/null
+++ b/src/plugins/ClaudeCode/statusbadges.h
@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#ifndef STATUSBADGES_H
+#define STATUSBADGES_H
+
+#include <QColor>
+#include <QHash>
+#include <QObject>
+#include <QString>
+
+namespace Konsole
+{
+class Session;
+}
+class SessionStatusRegistry;
+
+/**
+ * Optionally shows each session's status as its badge, the label Konsole
+ * draws in the terminal's top-right corner. Off by default; the setting is
+ * kept in konsolerc. While a status badge shows, the session's own badge
+ * settings are put aside and come back as they were when the status goes or
+ * badges are turned off.
+ */
+class StatusBadges : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit StatusBadges(SessionStatusRegistry *registry, QObject *parent = nullptr);
+
+    bool isEnabled() const;
+    void setEnabled(bool enabled);
+
+Q_SIGNALS:
+    void enabledChanged(bool enabled);
+
+private:
+    struct Badge {
+        bool enabled = false;
+        QString text;
+        QColor color;
+        bool textOnly = false;
+    };
+
+    void update(Konsole::Session *session);
+    static Badge badgeOf(Konsole::Session *session);
+    static void setBadge(Konsole::Session *session, const Badge &badge);
+
+    SessionStatusRegistry *_registry;
+    bool _enabled;
+    // The badge each session had before a status badge replaced it.
+    QHash<Konsole::Session *, Badge> _saved;
+};
+
+#endif // STATUSBADGES_H
