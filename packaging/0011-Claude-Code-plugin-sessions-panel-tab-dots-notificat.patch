+// SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "sessionnavigation.h"
+
+#include "MainWindow.h"
