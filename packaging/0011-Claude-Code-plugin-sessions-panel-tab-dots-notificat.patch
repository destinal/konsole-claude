index 32842cd..5a10108 100644
--- a/src/plugins/ClaudeCode/claudesessionswidget.cpp
+++ b/src/plugins/ClaudeCode/claudesessionswidget.cpp
@@ -2,21 +2,136 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 
 #include "claudesessionswidget.h"
