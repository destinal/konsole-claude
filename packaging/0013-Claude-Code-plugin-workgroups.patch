diff --git a/src/plugins/ClaudeCode/workgroup.cpp b/src/plugins/ClaudeCode/workgroup.cpp
new file mode 100644
index 0000000..c6b914e
--- /dev/null
+++ b/src/plugins/ClaudeCode/workgroup.cpp
@@ -0,0 +1,179 @@
+// SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "workgroup.h"
+#include "workgroupswitcher.h"
+
+#include "MainWindow.h"
+#include "ViewManager.h"
+#include "profile/Profile.h"
+#include "session/Session.h"
+#include "session/SessionManager.h"
+#include "terminalDisplay/TerminalDisplay.h"
+#include "widgets/TerminalHeaderBar.h"
+#include "widgets/ViewContainer.h"
+#include "widgets/ViewSplitter.h"
+
+#include <KLocalizedString>
+
+#include <QBoxLayout>
+#include <QDBusConnection>
+#include <QProcessEnvironment>
+
+QStringList Workgroup::memberNames()
+{
+    return {i18nc("@action:button workgroup member", "Chat"),
+            i18nc("@action:button workgroup member", "Diff"),
+            i18nc("@action:button workgroup member", "Code Review")};
+}
+
+Workgroup::Workgroup(Konsole::Session *chat, const QString &toolsDirectory, QObject *parent)
+    : QObject(parent)
+{
+    _sessions[Chat] = chat;
+    _sessions[Diff] = createMember(Diff, toolsDirectory);
+    _sessions[Review] = createMember(Review, toolsDirectory);
+
+    for (int member = 0; member < memberCount; member++) {
+        Konsole::Session *session = _sessions[member];
+        if (session == nullptr) {
+            continue;
+        }
+        addSwitcher(Member(member));
+        // Closing any member ends the workgroup, as in iTerm2.
+        connect(session, &QObject::destroyed, this, &Workgroup::dissolve);
+    }
+    show(Chat);
+}
+
+Workgroup::~Workgroup() = default;
+
+Konsole::Session *Workgroup::createMember(Member member, const QString &toolsDirectory)
+{
+    Konsole::Session *chat = _sessions[Chat];
+    Konsole::TerminalDisplay *chatView = view(Chat);
+    auto *window = chatView != nullptr ? qobject_cast<Konsole::MainWindow *>(chatView->window()) : nullptr;
+    if (window == nullptr) {
+        return nullptr;
+    }
+    Konsole::ViewManager *viewManager = window->viewManager();
+
+    // The members split the Chat session's view, in its directory.
+    viewManager->setCurrentSession(chat->sessionId());
+    auto profile = Konsole::SessionManager::instance()->sessionProfile(chat);
+    Konsole::Session *session = viewManager->createSession(profile, chat->currentWorkingDirectory());
+
+    const QString script = toolsDirectory + (member == Diff ? QLatin1String("/claudecode-diff") : QLatin1String("/claudecode-review"));
+    session->setProgram(QStringLiteral("/bin/bash"));
+    session->setArguments({QStringLiteral("/bin/bash"), script});
+    // A review runs it2 to file its findings with the Chat session.
+    const QString path = QProcessEnvironment::systemEnvironment().value(QStringLiteral("PATH"));
+    session->addEnvironmentEntry(QStringLiteral("PATH=%1:%2").arg(toolsDirectory, path));
+    session->addEnvironmentEntry(
+        QStringLiteral("TERM_SESSION_ID=konsole:%1/Sessions/%2").arg(QDBusConnection::sessionBus().baseService()).arg(chat->sessionId()));
+    session->setTitle(Konsole::Session::NameRole, memberNames().at(member));
+
+    Konsole::TerminalDisplay *display = viewManager->createView(session);
+    viewManager->activeContainer()->splitView(display, Qt::Horizontal);
+    return session;
+}
+
+Konsole::Session *Workgroup::session(Member member) const
+{
+    return _sessions[member];
+}
+
+bool Workgroup::contains(Konsole::Session *session) const
+{
+    return std::find(_sessions.begin(), _sessions.end(), session) != _sessions.end();
+}
+
+Workgroup::Member Workgroup::current() const
+{
+    return _current;
+}
+
+Konsole::TerminalDisplay *Workgroup::view(Member member) const
+{
+    Konsole::Session *session = _sessions[member];
+    if (session == nullptr || session->views().isEmpty()) {
+        return nullptr;
+    }
+    return session->views().first();
+}
+
+void Workgroup::addSwitcher(Member member)
+{
+    Konsole::TerminalDisplay *display = view(member);
+    auto *layout = display != nullptr ? qobject_cast<QBoxLayout *>(display->headerBar()->layout()) : nullptr;
+    if (layout == nullptr) {
+        return;
+    }
+    auto *switcher = new WorkgroupSwitcher(memberNames(), display->headerBar());
+    // After the session's icon, before its title.
+    layout->insertWidget(1, switcher);
+    connect(switcher, &WorkgroupSwitcher::memberChosen, this, [this](int chosen) {
+        show(Member(chosen));
+    });
+    _switchers.append(switcher);
+}
+
+void Workgroup::show(Member member)
+{
+    Konsole::TerminalDisplay *display = view(member);
+    if (display == nullptr) {
+        return;
+    }
+    Konsole::ViewSplitter *splitter = Konsole::ViewSplitter::parentSplitterForDisplay(display);
+    if (splitter == nullptr) {
+        return;
+    }
+    Konsole::ViewSplitter *top = splitter->getToplevelSplitter();
+    top->clearMaximized();
+    display->setFocus(Qt::OtherFocusReason);
+    // Maximizes the focused view, hiding the others.
+    top->toggleMaximizeCurrentTerminal();
+
+    _current = member;
+    for (const auto &switcher : std::as_const(_switchers)) {
+        if (switcher != nullptr) {
+            switcher->setCurrent(member);
+        }
+    }
+
+    // The diff waits to be seen, so that it shows the changes as they are then.
+    if (member == Diff && !_diffStarted) {
+        _diffStarted = true;
+        _sessions[Diff]->sendTextToTerminal(QString(), QLatin1Char('\r'));
+    }
+}
+
+void Workgroup::dissolve()
+{
+    if (_dissolving) {
+        return;
+    }
+    _dissolving = true;
+
+    for (const auto &switcher : std::as_const(_switchers)) {
+        delete switcher.data();
+    }
+    _switchers.clear();
+
+    // Show Chat on its own again, then close the others.
+    if (Konsole::TerminalDisplay *display = view(Chat)) {
+        if (Konsole::ViewSplitter *splitter = Konsole::ViewSplitter::parentSplitterForDisplay(display)) {
+            splitter->getToplevelSplitter()->clearMaximized();
+        }
+        display->setFocus(Qt::OtherFocusReason);
+    }
+    for (Member member : {Diff, Review}) {
+        if (Konsole::Session *session = _sessions[member]) {
+            disconnect(session, nullptr, this, nullptr);
+            session->closeInNormalWay();
+        }
+    }
+    Q_EMIT dissolved();
+}
+
+#include "moc_workgroup.cpp"
diff --git a/src/plugins/ClaudeCode/workgroup.h b/src/plugins/ClaudeCode/workgroup.h
new file mode 100644
index 0000000..0214d90
--- /dev/null
+++ b/src/plugins/ClaudeCode/workgroup.h
@@ -0,0 +1,77 @@
+// SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#ifndef WORKGROUP_H
+#define WORKGROUP_H
+
+#include <QList>
+#include <QObject>
+#include <QPointer>
+#include <QString>
+
+#include <array>
+
+namespace Konsole
+{
+class Session;
+class TerminalDisplay;
+}
+class WorkgroupSwitcher;
+
+/**
+ * A Claude Code workgroup, after iTerm2's: the session running Claude Code
+ * (Chat) and two members beside it, Diff and Code Review. They share the
+ * Chat session's tab as splits, one maximized at a time; a switcher in each
+ * member's header bar, or a shortcut, shows another.
+ *
+ * The members start nothing on their own: Diff runs its diff the first time
+ * it is shown, and Code Review starts a review when asked.
+ */
+class Workgroup : public QObject
+{
+    Q_OBJECT
+
+public:
+    enum Member {
+        Chat,
+        Diff,
+        Review,
+    };
+    static constexpr int memberCount = 3;
+
+    /** The members' names, in switcher order. */
+    static QStringList memberNames();
+
+    /**
+     * Builds a workgroup around @p chat, whose tab gains the other members.
+     * @p toolsDirectory holds the member scripts and it2.
+     */
+    Workgroup(Konsole::Session *chat, const QString &toolsDirectory, QObject *parent = nullptr);
+    ~Workgroup() override;
+
+    Konsole::Session *session(Member member) const;
+    bool contains(Konsole::Session *session) const;
+    Member current() const;
+
+    /** Shows @p member in place of the others. */
+    void show(Member member);
+
+    /** Closes the Diff and Code Review members and shows Chat as it was. Emits dissolved(). */
+    void dissolve();
+
+Q_SIGNALS:
+    void dissolved();
+
+private:
+    Konsole::Session *createMember(Member member, const QString &toolsDirectory);
+    Konsole::TerminalDisplay *view(Member member) const;
+    void addSwitcher(Member member);
+
+    std::array<QPointer<Konsole::Session>, memberCount> _sessions;
+    QList<QPointer<WorkgroupSwitcher>> _switchers;
+    Member _current = Chat;
+    bool _diffStarted = false;
+    bool _dissolving = false;
+};
+
+#endif // WORKGROUP_H
diff --git a/src/plugins/ClaudeCode/workgroup/claudecode-diff b/src/plugins/ClaudeCode/workgroup/claudecode-diff
new file mode 100755
index 0000000..26820a5
--- /dev/null
+++ b/src/plugins/ClaudeCode/workgroup/claudecode-diff
@@ -0,0 +1,43 @@
+#!/bin/bash
+# SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# The Diff member of a Claude Code workgroup in Konsole.
+#
+#   claudecode-diff [BASE]
+#
+# Waits for Enter, which the Claude Code plugin types the first time the
+# member is shown, then runs the diff against BASE (default HEAD) once git
+# reports staged or unstaged changes. Enter runs it again later. The command
+# is $CLAUDECODE_DIFF_COMMAND (default: git difftool -y -x vimdiff), with BASE
+# appended.
+
+base=${1:-HEAD}
+command=${CLAUDECODE_DIFF_COMMAND:-git difftool -y -x vimdiff}
+
+has_changes() {
+    # Staged or tracked unstaged changes; untracked files do not count.
+    ! git diff --quiet "$base" -- 2>/dev/null
+}
+
+clear
+printf 'Diff against %s\n\nThis session shows the working tree'"'"'s changes when you switch to it.\n' "$base"
+while read -r _; do
+    if ! git rev-parse --git-dir >/dev/null 2>&1; then
+        printf '\n%s is not in a git repository. Press Enter to check again.\n' "$PWD"
+        continue
+    fi
+    while ! has_changes; do
+        clear
+        printf 'Diff session is waiting for changes.\n\n'
+        printf 'This session only starts its command when git reports staged or unstaged\n'
+        printf 'changes against %s, and the working tree is clean. Edit a file (or stage\n' "$base"
+        printf 'one) and the command will start on its own. Press Enter to run it now anyway.\n'
+        if read -r -t 2 _; then
+            break
+        fi
+    done
+    clear
+    bash -c "$command \"\$1\"" claudecode-diff "$base"
+    printf '\nDiff finished. Press Enter to run it again.\n'
+done
diff --git a/src/plugins/ClaudeCode/workgroup/claudecode-review b/src/plugins/ClaudeCode/workgroup/claudecode-review
new file mode 100755
index 0000000..c40d93c
--- /dev/null
+++ b/src/plugins/ClaudeCode/workgroup/claudecode-review
@@ -0,0 +1,56 @@
+#!/bin/bash
+# SPDX-FileCopyrightText: 2026 Eric Duprey <509630+destinal@users.noreply.github.com>
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# The Code Review member of a Claude Code workgroup in Konsole.
+#
+# Starts nothing until asked: Enter starts a Claude Code review of the
+# pending changes with the review prompt, e edits the prompt first. The
+# prompt is kept in $XDG_CONFIG_HOME/konsole-claudecode/review-prompt.txt.
+# When code-review-system-prompt.txt and code-review-settings.json sit next to
+# this script, the review gets them too.
+
+here=$(dirname "$(readlink -f "$0")")
+prompt=${XDG_CONFIG_HOME:-$HOME/.config}/konsole-claudecode/review-prompt.txt
+if [ ! -f "$prompt" ]; then
+    mkdir -p "$(dirname "$prompt")"
+    cp "$here/review-prompt.txt" "$prompt"
+fi
+
+arguments=()
+[ -f "$here/code-review-system-prompt.txt" ] && arguments+=(--append-system-prompt-file "$here/code-review-system-prompt.txt")
+[ -f "$here/code-review-settings.json" ] && arguments+=(--settings "$here/code-review-settings.json")
+
+while :; do
+    width=$(tput cols)
+    clear
+    printf 'Code Review\n\nReview prompt (%s):\n\n' "$prompt"
+    sed 's/^/    /' "$prompt" | fold -s -w "$((width - 4))"
+    printf '\nEnter: start the review    e: edit the prompt\n'
+    # Wait for a key, redrawing if the view is resized meanwhile (it starts
+    # out narrow, before the workgroup shows it).
+    while :; do
+        read -r -s -n 1 -t 0.5 key
+        status=$?
+        if [ $status -le 128 ]; then
+            break
+        fi
+        [ "$(tput cols)" != "$width" ] && break
+    done
+    if [ $status -gt 128 ]; then
+        continue
+    elif [ $status -ne 0 ]; then
+        exit 0
+    fi
+    case "$key" in
+    e | E)
+        ${VISUAL:-${EDITOR:-vim}} "$prompt"
+        ;;
+    "")
+        clear
+        claude "$(cat "$prompt")" "${arguments[@]}"
+        printf '\nReview finished. Press Enter to continue.\n'
+        read -r _ || exit 0
+        ;;
+    esac
+done
