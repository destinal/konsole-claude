@@ -43,8 +43,8 @@ QVariant ClaudeSessionsModel::data(const QModelIndex &index, int role) const
         return ClaudeCode::sessionTitle(session);
     case Qt::ToolTipRole: {
         QString tip = ClaudeCode::sessionTitle(session) + QLatin1String(" — ") + status->statusText().value_or(QString());
-        if (status->detail().has_value()) {
-            tip += QLatin1Char('\n') + *status->detail();
+        if (status->shownDetail().has_value()) {
+            tip += QLatin1Char('\n') + *status->shownDetail();
         }
         return tip;
     }
@@ -55,7 +55,7 @@ QVariant ClaudeSessionsModel::data(const QModelIndex &index, int role) const
     case IndicatorRole:
         return status->indicator();
     case DetailRole:
-        return status->detail().value_or(QString());
+        return status->shownDetail().value_or(QString());
     case SessionRole:
         return QVariant::fromValue<QObject *>(session);
     }
diff --git a/src/plugins/ClaudeCode/sessionstatus.cpp b/src/plugins/ClaudeCode/sessionstatus.cpp
index cc89280..d065d0e 100644
--- a/src/plugins/ClaudeCode/sessionstatus.cpp
+++ b/src/plugins/ClaudeCode/sessionstatus.cpp
@@ -20,6 +20,13 @@ namespace
 const QColor idleIndicator(0x00, 0xd7, 0x5f);
 const QColor idleStatusColor(0x88, 0x88, 0x88);
 
+// A finished turn the user has seen: its summary is still worth showing.
+bool isSeenResult(const std::optional<QString> &before, const std::optional<QString> &after)
+{
+    const QString from = before.value_or(QString()).toLower();
+    return (from == QLatin1String("done") || from == QLatin1String("error")) && after.value_or(QString()).toLower() == QLatin1String("idle");
+}
+
 std::optional<QString> stringArgument(const QVariantMap &arguments, const char *key)
 {
     const auto it = arguments.constFind(QLatin1String(key));
@@ -196,6 +203,11 @@ std::optional<QString> SessionStatus::detail() const
     return _display.detail;
 }
 
+std::optional<QString> SessionStatus::shownDetail() const
+{
+    return _shownDetail;
+}
+
 qint64 SessionStatus::backgroundTasks() const
 {
     return _backgroundTasks;
@@ -313,7 +325,14 @@ bool SessionStatus::applyFields(const TabStatusFields &fields)
     if (fields.detail.has_value()) {
         _display.detail = fields.detail->isEmpty() ? std::nullopt : fields.detail;
     }
-    return !(_display == before);
+
+    const auto shownBefore = _shownDetail;
+    if (_display.detail.has_value()) {
+        _shownDetail = _display.detail;
+    } else if (_display.statusText != before.statusText && !isSeenResult(before.statusText, _display.statusText)) {
+        _shownDetail.reset();
+    }
+    return !(_display == before) || _shownDetail != shownBefore;
 }
 
 void SessionStatus::progressReported(const std::optional<TerminalProgress> &progress)
@@ -393,6 +412,7 @@ bool SessionStatus::clearStatus()
     ++_generation;
     const auto previousText = _display.statusText;
     _display = Display();
+    _shownDetail.reset();
     _backgroundTasks = 0;
     _turnOpen.reset();
     Q_EMIT changed(previousText);
@@ -404,6 +424,7 @@ void SessionStatus::programDidExit()
     const bool wasActive = hasActiveStatus();
     const auto previousText = _display.statusText;
     _display = Display();
+    _shownDetail.reset();
     _backgroundTasks = 0;
     _turnOpen.reset();
     _armedFallback.reset();
diff --git a/src/plugins/ClaudeCode/sessionstatus.h b/src/plugins/ClaudeCode/sessionstatus.h
index f30f299..5e1c504 100644
--- a/src/plugins/ClaudeCode/sessionstatus.h
+++ b/src/plugins/ClaudeCode/sessionstatus.h
@@ -88,6 +88,16 @@ public:
     /** Invalid when there is no status text color. */
     QColor statusColor() const;
     std::optional<QString> detail() const;
+    /**
+     * The detail to show people: the detail, or when an update cleared it
+     * without changing the status, the last one there was. Claude Code
+     * reports what a tool is doing only while it runs, and its own done
+     * report carries no message, so the detail alone would blink and lose
+     * the turn's summary. A new status clears it, except a finished one the
+     * user has seen, which keeps its summary as iTerm2's does. Not part of
+     * iTerm2's model, so detail() and toJson() leave it out.
+     */
+    std::optional<QString> shownDetail() const;
     qint64 backgroundTasks() const;
     std::optional<bool> turnOpen() const;
 
@@ -154,6 +164,7 @@ private:
     const int _progressEndDelayMs;
 
     Display _display;
+    std::optional<QString> _shownDetail;
     qint64 _backgroundTasks = 0;
     std::optional<bool> _turnOpen;
 
